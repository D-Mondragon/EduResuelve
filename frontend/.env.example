# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API / Data API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publishable-o-anon

# Opcional: nombre de la institución que aparece en el encabezado de las actas de resolución
# VITE_INSTITUTION_NAME=I.E. Nombre de tu institución

# Opcional: medición anónima de tiempos de respuesta (RNF-001). Activada por defecto; 'false' la desactiva.
# VITE_PERF_LOG=true
